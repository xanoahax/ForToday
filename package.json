{
  "name": "fortoday",
  "version": "1.1.0",
  "description": "Eine ruhige, lokale To-do-App für einen Tag nach dem anderen.",
  "author": "ForToday",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "node tests/app.cjs",
    "test:portable": "node tests/portable.cjs",
    "test:desktop": "node tests/desktop-app.cjs",
    "build": "electron-builder --win nsis portable --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "local.fortoday.app",
    "productName": "ForToday",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "ForToday-${version}-Portable.exe"
    },
    "nsis": {
      "artifactName": "ForToday-${version}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ForToday",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerLanguages": ["de_DE", "en_US"]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
